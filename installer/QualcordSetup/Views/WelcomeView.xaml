<UserControl x:Class="CustomInstaller.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CustomInstaller.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="680">
    <Grid Margin="36,20,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <!-- App Logo with Subtle Glow -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,14">
                <controls:ZenCordLogo Width="64" Height="64">
                    <controls:ZenCordLogo.Effect>
                        <DropShadowEffect Color="#5865F2" Opacity="0.45" BlurRadius="22" ShadowDepth="0" />
                    </controls:ZenCordLogo.Effect>
                </controls:ZenCordLogo>
            </Grid>

            <!-- App Title & Version Header -->
            <TextBlock x:Name="TxtAppName"
                       Text="Qualcord"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                <Border Background="#1C1E26" BorderBrush="#2D303C" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtVersion"
                               Text="Version 1.0.30"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#818CF8" />
                </Border>
                <TextBlock x:Name="TxtPublisher"
                           Text="bereitgestellt von Qualcord Community"
                           FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Description Card -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,8">
                <Border.Effect>
                    <StaticResource ResourceKey="CardShadow" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtDescription"
                               Text="Willkommen beim Qualcord Setup. Dieser Assistent erweitert Discord nahtlos um automatische Quests, individuelle Themes, hunderte Plugins und das Live Plugin Studio."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="19" />
                    
                    <Separator Background="#22242B" Margin="0,10,0,8" />
                    
                    <!-- Detected Discord Installation info -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 8,2 L 15,5 V 10 C 15,14 12,18 8,20 C 4,18 1,14 1,10 V 5 Z M 5,10 L 7,12 L 11,7"
                              Stroke="#5865F2"
                              StrokeThickness="1.5"
                              Width="13" Height="15"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtDetectedDiscord"
                                   Text="Erkannte Installation: Discord Standard"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnCustom"
                        Content="Optionen anpassen"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="BtnCustom_Click" />
                <Button x:Name="BtnUninstall"
                        Content="Deinstallieren"
                        Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource DangerBrush}"
                        Visibility="Collapsed"
                        Click="BtnUninstall_Click" />
            </StackPanel>

            <!-- Primary 1-Click Express Install Button -->
            <Button x:Name="BtnExpress"
                    Grid.Column="1"
                    Content="⚡ In Discord installieren"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="190"
                    Click="BtnExpress_Click" />
        </Grid>
    </Grid>
</UserControl>
