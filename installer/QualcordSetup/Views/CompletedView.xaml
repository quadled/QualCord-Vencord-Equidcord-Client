<UserControl x:Class="CustomInstaller.Views.CompletedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="680">
    <Grid Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <!-- Success Icon Badge -->
            <Border Width="60" Height="60"
                    CornerRadius="30"
                    Background="{StaticResource SuccessBrush}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#23A55A" Opacity="0.5" BlurRadius="20" ShadowDepth="0" />
                </Border.Effect>
                <Path Data="M 12,25 L 22,35 L 38,15"
                      Stroke="White"
                      StrokeThickness="3.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="26" Height="26"
                      Stretch="Uniform" />
            </Border>

            <TextBlock Text="Qualcord erfolgreich installiert!"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />

            <TextBlock x:Name="TxtSummary"
                       Text="Discord wurde erfolgreich erweitert und ist sofort startklar."
                       FontSize="13.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,18" />

            <!-- Summary Information Card -->
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <StaticResource ResourceKey="CardShadow" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Installationsdetails"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6" />

                    <TextBlock x:Name="TxtInstalledBranch"
                               Text="Discord (Standard) • v1.0.30"
                               FontSize="13.5"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,4" />

                    <TextBlock x:Name="TxtInstalledPath"
                               Text="C:\Users\..."
                               FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas, Segoe UI, sans-serif"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Launch CheckBox -->
            <CheckBox x:Name="ChkLaunchApp"
                      Content="Discord jetzt starten"
                      IsChecked="True"
                      Margin="2,0,0,0" />
        </StackPanel>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Button x:Name="BtnFinish"
                    Content="Fertigstellen"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="150"
                    HorizontalAlignment="Right"
                    Click="BtnFinish_Click" />
        </Grid>
    </Grid>
</UserControl>
