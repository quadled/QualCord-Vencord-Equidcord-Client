<UserControl x:Class="CustomInstaller.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="680">
    <Grid Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Prompt State Panel -->
        <StackPanel x:Name="PanelPrompt" Grid.Row="0" VerticalAlignment="Center">
            <!-- Warning Badge -->
            <Border Width="60" Height="60"
                    CornerRadius="14"
                    Background="#261416"
                    BorderBrush="#451E22"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,18">
                <!-- Trash Can / Remove Icon -->
                <Path Data="M 10,12 H 30 M 16,12 V 8 H 24 V 12 M 13,12 V 28 C 13,30 15,32 17,32 H 23 C 25,32 27,30 27,28 V 12 M 17,17 V 26 M 23,17 V 26"
                      Stroke="{StaticResource DangerBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="26" Height="26"
                      Stretch="Uniform" />
            </Border>

            <TextBlock x:Name="TxtUninstallTitle"
                       Text="Anwendung deinstallieren"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />

            <TextBlock x:Name="TxtUninstallSubtitle"
                       Text="Möchten Sie diese Anwendung und alle zugehörigen Komponenten wirklich von Ihrem System entfernen?"
                       FontSize="13.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,20"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Border.Effect>
                    <StaticResource ResourceKey="CardShadow" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Installationsverzeichnis"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtUninstallPath"
                               Text="C:\Program Files\..."
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas, Segoe UI, sans-serif" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Progress State Panel -->
        <StackPanel x:Name="PanelProgress" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Deinstallation wird durchgeführt..."
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20" />

            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,18">
                <Border.Effect>
                    <StaticResource ResourceKey="CardShadow" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="TxtStatus"
                                   Text="Bereite Deinstallation vor..."
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TxtPercent"
                                   Text="0 %"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="ProgressUninstall" Height="8" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Finished State Panel -->
        <StackPanel x:Name="PanelFinished" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
            <Border Width="60" Height="60"
                    CornerRadius="30"
                    Background="{StaticResource SuccessBrush}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,18">
                <Border.Effect>
                    <DropShadowEffect Color="#23A55A" Opacity="0.4" BlurRadius="18" ShadowDepth="0" />
                </Border.Effect>
                <Path Data="M 12,25 L 22,35 L 38,15"
                      Stroke="White"
                      StrokeThickness="3.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="26" Height="26"
                      Stretch="Uniform" />
            </Border>
            <TextBlock Text="Deinstallation abgeschlossen"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Die Anwendung wurde erfolgreich von Ihrem Computer entfernt."
                       FontSize="13.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <!-- Buttons for Prompt State -->
            <Grid x:Name="GridPromptButtons">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCancel"
                        Grid.Column="0"
                        Content="Abbrechen"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Click="BtnCancel_Click" />
                <Button x:Name="BtnConfirmUninstall"
                        Grid.Column="1"
                        Content="Deinstallieren"
                        Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource DangerBrush}"
                        MinWidth="150"
                        Click="BtnConfirmUninstall_Click" />
            </Grid>

            <!-- Buttons for Finished State -->
            <Button x:Name="BtnClose"
                    Content="Schließen"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    MinWidth="140"
                    Visibility="Collapsed"
                    Click="BtnClose_Click" />
        </Grid>
    </Grid>
</UserControl>
