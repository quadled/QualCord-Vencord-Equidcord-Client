<UserControl x:Class="CustomInstaller.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="680">
    <Grid Margin="36,20,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Installationsoptionen"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />
            <TextBlock Text="Wählen Sie die Discord-Version und bevorzugte Einstellungen."
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Options Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- Discord Branch Card -->
                <Border Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <Border.Effect>
                        <StaticResource ResourceKey="CardShadow" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Discord-Version"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        
                        <ComboBox x:Name="CmbDiscordBranches"
                                  Height="34"
                                  Background="#1A1C23"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource CardBorderBrush}"
                                  SelectionChanged="CmbDiscordBranches_SelectionChanged"
                                  Margin="0,0,0,8" />

                        <TextBlock x:Name="TxtDiscordPath"
                                   Text="Pfad: C:\Users\..."
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <TextBlock x:Name="TxtPatchStatus"
                                   Text="Status: Bereit zur Installation"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <!-- Integration & Git Options Card -->
                <Border Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,8">
                    <Border.Effect>
                        <StaticResource ResourceKey="CardShadow" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Einstellungen &amp; Tools"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <CheckBox x:Name="ChkStartDiscord"
                                  Content="Discord nach der Installation automatisch neu starten"
                                  IsChecked="True"
                                  Margin="0,0,0,12" />

                        <CheckBox x:Name="ChkInstallGit"
                                  Content="Git für Windows automatisch mitinstallieren (Empfohlen für Updates)"
                                  IsChecked="True"
                                  Margin="0,0,0,6" />

                        <TextBlock x:Name="TxtGitStatus"
                                   Text="Git-Status wird geprüft..."
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="26,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button & Optional Uninstall -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnBack"
                        Content="Zurück"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="BtnBack_Click" />
                <Button x:Name="BtnUninstallBranch"
                        Content="Qualcord deinstallieren"
                        Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource DangerBrush}"
                        Visibility="Collapsed"
                        Click="BtnUninstallBranch_Click" />
            </StackPanel>

            <!-- Install Button -->
            <Button x:Name="BtnInstall"
                    Grid.Column="1"
                    Content="⚡ Qualcord installieren"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="180"
                    Click="BtnInstall_Click" />
        </Grid>
    </Grid>
</UserControl>
